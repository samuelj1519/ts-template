{
  "name": "frontend-project",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=26.13.1 <27",
    "bun": ">=1.3.11 <1.4"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives src e2e tools/checks vite.config.ts playwright.config.ts quality.config.ts .dependency-cruiser.cjs framework.config.ts vite.plugins.ts && node node_modules/eslint/bin/eslint.js --max-warnings 0 src e2e tools/checks vite.config.ts playwright.config.ts quality.config.ts .dependency-cruiser.cjs framework.config.ts vite.plugins.ts",
    "typecheck": "tsc --noEmit",
    "check:architecture": "node tools/checks/architecture.ts",
    "spell": "cspell --no-progress --must-find-files \"**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,json,md,yml,html,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && node tools/checks/coverage.ts",
    "test:policy": "node --test tools/checks/*.test.ts",
    "test:e2e": "bun run build && node tools/checks/browser.ts",
    "test:mutation": "bun run typecheck && stryker run && node tools/checks/mutation.ts",
    "check:unused": "knip --strict",
    "check:duplicates": "jscpd src --config .jscpd.json",
    "check:security": "bun audit --audit-level=low",
    "check:licenses": "node tools/checks/licenses.ts",
    "check:toolchain": "node tools/checks/toolchain.ts",
    "check": "bun run format:check && bun run check:toolchain && bun run lint && bun run typecheck && bun run check:architecture && bun run spell",
    "check:full": "bun run check && bun run test:policy && bun run test:coverage && bun run test:e2e && bun run check:unused && bun run check:licenses",
    "check:milestone": "bun run check:full && bun run test:mutation && bun run check:duplicates"
  },
  "dependencies": {},
  "overrides": {
    "minimatch": "11.0.8",
    "glob": "14.0.6",
    "qs": "6.17.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@swc/core": "1.16.22",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "cspell": "10.4.1",
    "dependency-cruiser": "18.7.2",
    "jscpd": "5.4.3",
    "jsdom": "31.0.1",
    "jsonc-parser": "3.3.1",
    "knip": "6.45.1",
    "license-checker-rseidelsohn": "5.0.1",
    "oxlint": "1.93.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "zod": "4.6.7",
    "eslint": "10.15.0",
    "typescript-eslint": "8.72.2"
  }
}
